  "license": "MIT",
  "homepage": "https://github.com/karanrao/hotelbeds-mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karanrao/hotelbeds-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/karanrao/hotelbeds-mcp-server/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  }
}
